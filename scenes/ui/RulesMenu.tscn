theme = ExtResource("2_ac37y")
theme_type_variation = &"rulesText"
text = "• Select a robot in the deployed-units panel or by left-clicking it.
• Move a selected robot with W/A/S/D, or right-click a destination.
• Center the camera on the pointer with Space.
• Pan the camera with the arrow keys or by dragging the terrain.
• Zoom with the mouse wheel.
• Open the pause menu with Escape.

See the Controls menu for the complete reference."
autowrap_mode = 3

