[node name="Label" type="Label" parent="Panel/TabContainer/AUTONOMY/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
theme = ExtResource("2_ac37y")
theme_type_variation = &"rulesText"
text = "Each robot can be moved manually or assigned one of four autonomous actions:

MOVE: Travel directly to a destination selected by the player.

RANDOM: Explore the map in random directions.

SEARCH HIGH ANOMALY: Follow increasingly strong gravitational-anomaly readings.

BACK TO BASE: Return to the landing module to recharge.
"
autowrap_mode = 3

