layout_mode = 2
theme = ExtResource("2_ac37y")
theme_type_variation = &"rulesText"
text = "CAPABILITIES:
• Can recover a stuck ground rover when nearby
• Moves quickly
• Can fly over rough terrain and water
• Can lift and carry the UGV
• Has a 10-unit vision-sensor range
LIMITATIONS:
• Cannot collect resources
• Cannot analyze the monolith"
autowrap_mode = 3

