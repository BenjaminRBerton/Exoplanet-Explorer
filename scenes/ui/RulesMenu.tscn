theme = ExtResource("2_ac37y")
theme_type_variation = &"rulesText"
text = "The game begins with a central landing module. Its relay antenna enables communication with the robots.

ANTENNA: To operate, each robot must remain within the communication network. Connected robots also act as relays.
Coverage radii: • 10 units around the base.
• 6 units around each flying drone (UAV).
• 4 units around each ground rover (UGV)."
autowrap_mode = 3

