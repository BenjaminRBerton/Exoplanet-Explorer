[node name="Label" type="Label" parent="Panel/TabContainer/UGV/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
theme = ExtResource("2_ac37y")
theme_type_variation = &"rulesText"
text = "CAPABILITIES:
• Can analyze the monolith. To complete the mission, reach it with the UGV.
• Can collect resources
• Can build bridges with wood
• Battery supports up to 250 moves before recharging
LIMITATIONS:
• May become stuck and require a UAV to recover it
• Moves slowly and cannot cross rough terrain, climb, or swim"
autowrap_mode = 3

